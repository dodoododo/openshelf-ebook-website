# OpenShelf Environment Variables (Example Template)
# Copy this file to .env and adjust variables as needed for local development.

# PostgreSQL Configuration
POSTGRES_DB=openshelf_db
POSTGRES_USER=openshelf
POSTGRES_PASSWORD=your_local_password
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Private PDF storage. Leave unset to use the JVM user's home/.openshelf/storage/books.
# Any override MUST be absolute and outside publicly served directories.
# OPENSHELF_STORAGE_ROOT=D:/OpenShelf/storage/books
OPENSHELF_UPLOAD_MAX_BYTES=31457280
OPENSHELF_UPLOAD_MAX_FILE_SIZE=30MB
OPENSHELF_UPLOAD_MAX_REQUEST_SIZE=31MB
